*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A FORWARD -i inside -o uplink -s 10.32.24.0/24 -j ACCEPT
-A FORWARD -i uplink -o inside -d 10.32.24.0/24 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A POSTROUTING -s 10.32.24.0/24 -o uplink -j MASQUERADE
COMMIT
